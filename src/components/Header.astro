---
interface Link {
	href: string;
	label: string;
}

interface Props {
	links?: Link[];
}

const {
	links = [
		{ href: '/#shard', label: 'SHARD Protocol' },
		{ href: '/#process', label: 'Process' },
		{ href: '/#roadmap', label: 'Roadmap' },
		{ href: '/#press', label: 'Press' },
		{ href: '/#join', label: 'Join' },
	],
} = Astro.props;
---

<header
	data-header
	class="fixed inset-x-0 top-0 z-100 border-b border-transparent transition-[background-color,border-color] duration-300 ease-[var(--ease-out-expo)]"
>
	<nav class="rail flex items-center justify-between gap-6 py-4" aria-label="Main">
		<a href="/" class="flex items-center gap-3" aria-label="Miami Paradise Studio, home">
			<img
				src="/assets/images/android-chrome-192x192.png"
				alt=""
				width="30"
				height="30"
				class="rounded-full"
			/>
			<span class="text-base font-bold tracking-tight [font-variation-settings:'wdth'_96]">
				Miami Paradise Studio
			</span>
		</a>

		<ul class="hidden items-center gap-6 md:flex">
			{
				links.map((link) => (
					<li>
						<a
							href={link.href}
							class="group relative text-xs font-medium text-paper-dim transition-colors hover:text-paper"
						>
							{link.label}
							<span class="absolute -bottom-1.5 left-0 h-px w-full origin-left scale-x-0 bg-rose transition-transform duration-300 ease-[var(--ease-out-expo)] group-hover:scale-x-100" />
						</a>
					</li>
				))
			}
			<li>
				<span
					class="cursor-not-allowed rounded-full border border-[var(--edge-strong)] px-4 py-2 text-xs text-paper-mute"
				>
					Discord soon
				</span>
			</li>
		</ul>

		<button
			type="button"
			popovertarget="mobile-nav"
			aria-label="Toggle menu"
			class="grid size-10 place-items-center md:hidden"
		>
			<span class="relative block h-[1.5px] w-5 bg-paper before:absolute before:h-[1.5px] before:w-5 before:-translate-y-1.5 before:bg-paper after:absolute after:h-[1.5px] after:w-5 after:translate-y-1.5 after:bg-paper"
			></span>
		</button>
	</nav>

	{/* Native popover: light dismiss, Escape and focus handling come from the
	    platform, which is why this component ships no menu script. */}
	<div
		id="mobile-nav"
		popover
		class="border-b border-[var(--edge)] bg-void/95 backdrop-blur-xl md:hidden"
	>
		<ul class="rail flex flex-col py-2">
			{
				links.map((link) => (
					<li class="border-b border-[var(--edge)] last:border-0">
						<a href={link.href} class="block py-4 text-lg">
							{link.label}
						</a>
					</li>
				))
			}
			<li class="py-4 text-lg text-paper-mute">Discord soon</li>
		</ul>
	</div>
</header>

<style>
	header.is-scrolled {
		background-color: color-mix(in oklch, var(--color-void) 88%, transparent);
		backdrop-filter: blur(14px) saturate(1.4);
		border-bottom-color: var(--edge);
	}
</style>


<style>
	header.is-scrolled {
		background-color: color-mix(in oklch, var(--color-void) 88%, transparent);
		backdrop-filter: blur(14px) saturate(1.4);
		border-bottom-color: var(--edge);
	}

	/* Popovers are display:none until open, so the entry transition needs
	   allow-discrete plus a starting style to have anything to animate from. */
	[popover] {
		position: fixed;
		inset: 4.5rem 0 auto;
		width: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		overflow: visible;
		color: inherit;
		opacity: 0;
		translate: 0 -8px;
		transition:
			opacity 200ms var(--ease-out-expo),
			translate 200ms var(--ease-out-expo),
			overlay 200ms allow-discrete,
			display 200ms allow-discrete;
	}

	[popover]:popover-open {
		opacity: 1;
		translate: 0 0;
	}

	@starting-style {
		[popover]:popover-open {
			opacity: 0;
			translate: 0 -8px;
		}
	}

	[popover]::backdrop {
		background: color-mix(in oklch, var(--color-void) 55%, transparent);
	}
</style>
