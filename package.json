{
	"name": "miami-paradise-studio",
	"version": "3.0.0",
	"private": true,
	"type": "module",
	"description": "Miami Paradise Studio - We build competitive worlds that fight back",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview --port 8000",
		"check": "astro check",
		"lint:css": "stylelint \"src/**/*.css\"",
		"test": "npm run check && npm run lint:css",
		"test:e2e": "playwright test",
		"test:size": "size-limit",
		"test:lighthouse": "lhci autorun"
	},
	"author": "Miami Paradise Studio",
	"license": "MIT",
	"homepage": "https://miamiparadise.studio",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Miami-Paradise-Studio/website.git"
	},
	"bugs": {
		"url": "https://github.com/Miami-Paradise-Studio/website/issues"
	},
	"dependencies": {
		"@astrojs/react": "^6.0.2",
		"@astrojs/sitemap": "^3.7.3",
		"@gsap/react": "^2.1.2",
		"@react-three/drei": "^10.7.8",
		"@react-three/fiber": "^9.7.0",
		"@react-three/postprocessing": "^3.0.5",
		"astro": "^7.2.0",
		"gsap": "^3.15.0",
		"lenis": "^1.3.26",
		"postprocessing": "^6.39.4",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"three": "~0.185.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@axe-core/playwright": "^4.12.1",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.62.1",
		"@size-limit/file": "^13.0.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/three": "^0.185.4",
		"size-limit": "^13.0.3",
		"stylelint": "^17.14.1",
		"stylelint-config-standard": "^40.0.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3"
	},
	"stylelint": {
		"extends": "stylelint-config-standard",
		"rules": {
			"at-rule-no-unknown": null,
			"custom-property-pattern": null,
			"lightness-notation": null,
			"hue-degree-notation": null,
			"alpha-value-notation": null,
			"color-function-notation": null,
			"declaration-property-value-no-unknown": null,
			"property-no-vendor-prefix": null,
			"font-family-name-quotes": null,
			"no-descending-specificity": null,
			"import-notation": null
		}
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true
	}
}
