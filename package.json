{
	"name": "miami-paradise-studio",
	"version": "2.1.0",
	"private": true,
	"description": "Miami Paradise Studio - We build competitive worlds that fight back",
	"main": "index.html",
	"scripts": {
		"start": "serve . -p 8000",
		"dev": "serve . -p 8000",
		"validate:html": "html-validate *.html",
		"validate:css": "stylelint \"assets/css/*.css\"",
		"validate:js": "eslint assets/js/main-new.js sw.js",
		"test": "npm run validate:html && npm run validate:css && npm run validate:js"
	},
	"keywords": [
		"game-studio",
		"competitive-gaming",
		"pvp",
		"voice-commands",
		"tactical-shooter",
		"shard-protocol",
		"miami-paradise-studio",
		"pwa"
	],
	"author": "Miami Paradise Studio",
	"license": "MIT",
	"homepage": "https://miamiparadise.studio",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Miami-Paradise-Studio/website.git"
	},
	"bugs": {
		"url": "https://github.com/Miami-Paradise-Studio/website/issues"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.8.1",
		"html-validate": "^11.6.2",
		"serve": "^14.2.6",
		"stylelint": "^17.14.1",
		"stylelint-config-standard": "^40.0.0"
	},
	"stylelint": {
		"extends": "stylelint-config-standard",
		"rules": {
			"alpha-value-notation": null,
			"color-function-alias-notation": null,
			"color-function-notation": null,
			"color-hex-length": null,
			"value-keyword-case": null,
			"keyframes-name-pattern": null,
			"rule-empty-line-before": null,
			"comment-empty-line-before": null,
			"declaration-empty-line-before": null,
			"at-rule-empty-line-before": null,
			"custom-property-empty-line-before": null,
			"media-feature-range-notation": null,
			"selector-not-notation": null,
			"no-descending-specificity": null,
			"no-duplicate-selectors": [
				true,
				{
					"severity": "warning"
				}
			]
		}
	},
	"browserslist": [
		"> 1%",
		"last 2 versions",
		"not dead"
	],
	"engines": {
		"node": ">=20.0.0"
	}
}
