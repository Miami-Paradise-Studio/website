{
	"ci": {
		"collect": {
			"staticDistDir": "./dist",
			"url": [
				"http://localhost/index.html",
				"http://localhost/shard-protocol/index.html"
			],
			"numberOfRuns": 3,
			"settings": {
				"preset": "desktop"
			},
			"chromeFlags": "--enable-unsafe-swiftshader --no-sandbox"
		},
		"assert": {
			"assertions": {
				"categories:accessibility": [
					"error",
					{
						"minScore": 1
					}
				],
				"categories:best-practices": [
					"error",
					{
						"minScore": 1
					}
				],
				"categories:seo": [
					"error",
					{
						"minScore": 1
					}
				],
				"categories:performance": [
					"warn",
					{
						"minScore": 0.9
					}
				],
				"cumulative-layout-shift": [
					"error",
					{
						"maxNumericValue": 0.05
					}
				],
				"largest-contentful-paint": [
					"warn",
					{
						"maxNumericValue": 2500
					}
				],
				"uses-responsive-images": "off",
				"unused-javascript": "off"
			}
		},
		"upload": {
			"target": "filesystem",
			"outputDir": ".lighthouseci"
		}
	}
}
