/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Content-Security-Policy is not set here. Astro emits it per page as a <meta>
# element with a hash for every inline script and style it generated, which no
# static header file can keep in sync. See security.csp in astro.config.mjs.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=2592000

/sw.js
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache
